# EmailJS (Book the Project page only)
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
VITE_DEVELOPER_EMAIL=your_email@example.com

# Consultation form (server-side only, set in Vercel > Settings > Environment Variables).
# Never prefix these with VITE_, or they would be exposed in the browser.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Inbox that receives enquiries. It is never shown on the website.
CONSULTATION_TO_EMAIL=you@example.com
# Sender. Must use a domain verified in Resend (SPF/DKIM), e.g. "HD NEXORA WEBTEC <hello@yourdomain.com>".
# Without a verified domain use "onboarding@resend.dev"; Resend then only delivers to your own Resend account email,
# so customer confirmation emails will not arrive.
CONSULTATION_FROM_EMAIL=HD NEXORA WEBTEC <hello@yourdomain.com>
# Optional: second inbox that receives a copy of every enquiry as a backup record.
CONSULTATION_BACKUP_EMAIL=

# Optional: WhatsApp notification for every enquiry (Meta WhatsApp Cloud API). Server-side only.
# Set up in developers.facebook.com > your app > WhatsApp > API Setup. See README "WhatsApp notifications".
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The number that receives the alerts, with country code, e.g. 919943711466
WHATSAPP_NOTIFY_TO=
# Approved template name and language (defaults: new_enquiry, en)
WHATSAPP_TEMPLATE=new_enquiry
WHATSAPP_TEMPLATE_LANG=en
